# Secrets de las Edge Functions. Copiá a supabase/functions/.env (ignorado por git) y completá.
# En producción se cargan con `supabase secrets set`, nunca con un archivo en el repo.

# Secreto HS256 del JWT del proyecto (en local: `supabase status -o env`, variable JWT_SECRET).
STEAM_AUTH_JWT_SECRET=
# Clave Web API de Steam y App ID del juego (solo para logins reales).
STEAM_WEB_API_KEY=
STEAM_APP_ID=
# Debe coincidir con OnlineApi.IDENTITY en el cliente.
STEAM_AUTH_IDENTITY=imba-arena-online
# Login de desarrollo: solo la cadena exacta "true" lo habilita. Vacío o ausente = apagado. NUNCA en producción.
STEAM_AUTH_ALLOW_DEV=
